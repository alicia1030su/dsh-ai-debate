# dsh-ai-debate 环境变量示例
#
# 这些变量不是插件读取的（插件从 DSH 的插件设置读配置），
# 列在这里是为了说明每个凭据的作用，以及在没有设置界面时应该填到哪里。
#
# 复制为 .env 并填入真实值即可用于本地开发调试；
# 千万不要把填好的 .env 提交到任何仓库。

# ── 主人身份 ────────────────────────────────────────────────
# 主人的贴吧数字用户 ID。优先使用这个；留空则退化为按账号名匹配。
DSH_DEBATE_OWNER_USER_ID=
# 主人的贴吧账号名（un）。仅在拿不到数字 ID 时使用，存在重名风险。
DSH_DEBATE_OWNER_USER_NAME=
# 允许召唤的额外主人 ID，逗号或空格分隔。
DSH_DEBATE_ALLOWED_OWNER_IDS=

# ── AI 账号 ────────────────────────────────────────────────
DSH_DEBATE_AI_ACCOUNT_NAME=
DSH_DEBATE_AI_ACCOUNT_USER_ID=

# ── 贴吧登录凭据 ─────────────────────────────────────────────
# 从浏览器开发者工具复制整个 Cookie 请求头的值。
# 只读帖子不需要；发表回复和检查登录状态需要。
# 这个值会被标记为 secret，不写日志、不写状态文件。
DSH_DEBATE_TIEBA_COOKIE=

# ── 模型接口（任意 OpenAI 兼容） ─────────────────────────────
DSH_DEBATE_LLM_BASE_URL=
DSH_DEBATE_LLM_API_KEY=
DSH_DEBATE_LLM_MODEL=

# ── 行为参数 ────────────────────────────────────────────────
# 人格：tieba_veteran | soft_defensive | tsundere | aloof
DSH_DEBATE_PERSONA=tieba_veteran
# 上下文预算档位：small(2000) | medium(4000) | large(8000)，设 DSH_DEBATE_CONTEXT_TOKENS 可覆盖
DSH_DEBATE_CONTEXT_PRESET=small
DSH_DEBATE_CONTEXT_TOKENS=0
# 互动模式：manual | single_shot | limited_auto
DSH_DEBATE_INTERACTION_MODE=manual
# 同一帖子最多发几条
DSH_DEBATE_MAX_PER_THREAD=10

# ── 存储 ────────────────────────────────────────────────────
# 留空则用 ~/.dsh/ai-debate
DSH_DEBATE_STORE_DIR=
